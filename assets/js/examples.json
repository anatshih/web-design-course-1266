{"u1-s6-0": {"code": "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<meta charset=\"utf-8\">\n<title>صفحتي الأولى</title>\n<h1>أتعلم تصميم الويب</h1>\n<p>هذه صفحة محلية.</p>\n<a href=\"https://example.com\">موقع تجريبي</a>\n</html>", "kind": "html", "title": "7. التطبيق الختامي والتقويم", "unit": 1, "source": "units/unit1.html#s6"}, "u2-structure-0": {"code": "<!DOCTYPE html>   <!-- 1. تعريف نوع الوثيقة -->\n<html dir=\"rtl\">    <!-- 2. بداية الصفحة وتحديد الاتجاه -->\n\n  <head>             <!-- 3. رأس الصفحة (معلومات للمتصفح) -->\n      <meta charset=\"UTF-8\">\n      <title>عنوان يظهر في الشريط العلوي</title>\n  </head>\n\n  <body>             <!-- 4. جسم الصفحة (المحتوى المرئي) -->\n      <h1>بسم الله الرحمن الرحيم</h1>\n      <p>هذا هو المحتوى الذي يراه الزائر.</p>\n  </body>\n\n</html>", "kind": "html", "title": "3. الهيكل العام لصفحة HTML", "unit": 2, "source": "units/unit2.html#structure"}, "u2-text-0": {"code": "<!-- العناوين: من الأكبر للأصغر -->\n<h1>العنوان الرئيسي (H1)</h1>\n<h2>عنوان فرعي (H2)</h2>\n\n<!-- الفقرات والخطوط -->\n<p>\n   هذا نص عادي، ولكن هذه الكلمة <b>غامقة (Bold)</b>.<br>\n   وهذه الكلمة <i>مائلة (Italic)</i>.<br>\n   وهذا النص <u>تحته خط (Underline)</u>.\n</p>\n\n<!-- الرموز العلمية -->\n<p>معادلة الماء: H<sub>2</sub>O</p>\n<p>الأسس الرياضية: 5<sup>2</sup> = 25</p>\n\n<!-- الرموز الخاصة -->\n<p>الحقوق محفوظة &copy; 2023 | 5 &lt; 10</p>", "kind": "html", "title": "4. تنسيق النصوص (Text Formatting)", "unit": 2, "source": "units/unit2.html#text"}, "u2-lists-0": {"code": "<h3>لغات برمجة الويب:</h3>\n\n<!-- قائمة غير مرتبة (نقاط) -->\n<ul>\n    <li>HTML</li>\n    <li>CSS</li>\n    <li>JavaScript\n        <!-- قائمة مرتبة متداخلة داخل العنصر -->\n        <ol type=\"a\">\n            <li>React.js</li>\n            <li>Vue.js</li>\n        </ol>\n    </li>\n</ul>", "kind": "html", "title": "5. القوائم (Lists)", "unit": 2, "source": "units/unit2.html#lists"}, "u2-media-0": {"code": "<!-- صورة عادية -->\n<img src=\"flower.jpg\" alt=\"زهرة حمراء\" width=\"200\" border=\"2\">\n\n<br><br>\n\n<!-- صورة داخل رابط -->\n<a href=\"https://www.google.com\" target=\"_blank\">\n    <img src=\"https://www.google.com/images/branding/googlelogo/1x/googlelogo_color_272x92dp.png\" alt=\"شعار جوجل\" width=\"100\">\n    <br> اضغط على الشعار للذهاب لجوجل\n</a>", "kind": "html", "title": "6. الصور والروابط التشعبية", "unit": 2, "source": "units/unit2.html#media"}, "u2-tables-0": {"code": "<table border=\"1\" cellpadding=\"10\">\n    <!-- رأس الجدول -->\n    <tr>\n        <th>اليوم</th>\n        <th>الساعة 8-10</th>\n        <th>الساعة 10-12</th>\n    </tr>\n\n    <!-- الصف الأول -->\n    <tr>\n        <td>السبت</td>\n        <td>رياضيات</td>\n        <td rowspan=\"2\" bgcolor=\"#eee\">مشروع (ساعتين)</td> <!-- دمج عمودي -->\n    </tr>\n\n    <!-- الصف الثاني -->\n    <tr>\n        <td>الأحد</td>\n        <td>فيزياء</td>\n        <!-- الخلية الثالثة محذوفة لأن السابقة أخذت مكانها -->\n    </tr>\n    \n    <!-- الصف الثالث -->\n    <tr>\n        <td>الاثنين</td>\n        <td colspan=\"2\" align=\"center\">إجازة</td> <!-- دمج أفقي -->\n    </tr>\n</table>", "kind": "html", "title": "7. الجداول (Tables)", "unit": 2, "source": "units/unit2.html#tables"}, "u2-forms-0": {"code": "<form action=\"save.php\" method=\"post\">\n    \n    <label>الاسم:</label>\n    <input type=\"text\" name=\"username\" placeholder=\"أدخل اسمك\"> <br><br>\n\n    <label>كلمة المرور:</label>\n    <input type=\"password\" name=\"pass\"> <br><br>\n\n    <label>الجنس:</label>\n    <input type=\"radio\" name=\"gender\" value=\"m\"> ذكر\n    <input type=\"radio\" name=\"gender\" value=\"f\"> أنثى <br><br>\n\n    <label>المهارات:</label>\n    <input type=\"checkbox\" name=\"skill1\"> HTML\n    <input type=\"checkbox\" name=\"skill2\"> CSS <br><br>\n\n    <label>المدينة:</label>\n    <select name=\"city\">\n        <option value=\"hebron\">الخليل</option>\n        <option value=\"jerusalem\">القدس</option>\n    </select> <br><br>\n\n    <label>ملاحظات:</label>\n    <textarea name=\"notes\" rows=\"3\" cols=\"30\"></textarea> <br><br>\n\n    <input type=\"submit\" value=\"تسجيل\">\n    <input type=\"reset\" value=\"مسح الحقول\">\n\n</form>", "kind": "html", "title": "8. النماذج (Forms)", "unit": 2, "source": "units/unit2.html#forms"}, "u2-css-intro-0": {"code": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        /* هذا سيؤثر على كل الفقرات في الصفحة */\n        p {\n            color: red;\n            font-size: 20px;\n        }\n        /* هذا تنسيق خاص (Class) */\n        .special {\n            background-color: yellow;\n            border: 1px solid black;\n        }\n    </style>\n</head>\n<body>\n    <p>هذا نص أحمر كبير.</p>\n    <p class=\"special\">هذا نص أحمر ومميز بخلفية صفراء.</p>\n</body>\n</html>", "kind": "html", "title": "9. مقدمة في CSS (Cascading Style Sheets)", "unit": 2, "source": "units/unit2.html#css-intro"}, "u3-addjs-0": {"code": "<html>\n<body>\n\n<h2>JavaScript Example</h2>\n<p id=\"demo\"></p>\n\n<script>\ndocument.getElementById(\"demo\").innerHTML = \"My First JavaScript\";\n</script>\n\n</body>\n</html>", "kind": "html", "title": "2. إضافة JavaScript إلى صفحة HTML", "unit": 3, "source": "units/unit3.html#addjs"}, "u3-input-output-0": {"code": "var name = prompt(\"Please enter your name:\");\nalert(\"Hello \" + name);", "kind": "js", "title": "3. الإدخال والإخراج في JavaScript", "unit": 3, "source": "units/unit3.html#input-output"}, "u3-input-output-1": {"code": "alert(\"Welcome to JavaScript\");", "kind": "js", "title": "3. الإدخال والإخراج في JavaScript", "unit": 3, "source": "units/unit3.html#input-output"}, "u3-input-output-2": {"code": "document.write(\"This is JavaScript Output\");", "kind": "js", "title": "3. الإدخال والإخراج في JavaScript", "unit": 3, "source": "units/unit3.html#input-output"}, "u3-input-output-3": {"code": "<p id=\"demo\"></p>\n<script>\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript\";\n</script>", "kind": "html", "title": "3. الإدخال والإخراج في JavaScript", "unit": 3, "source": "units/unit3.html#input-output"}, "u3-variables-0": {"code": "var price1 = 5;\nvar price2 = 6;\nvar total = price1 + price2;\n\nalert(total);", "kind": "js", "title": "4. المتغيرات وأنواع البيانات", "unit": 3, "source": "units/unit3.html#variables"}, "u3-number-0": {"code": "var num1 = Number(prompt(\"Enter first number\"));\nvar num2 = Number(prompt(\"Enter second number\"));\n\nvar sum = num1 + num2;\n\nalert(sum);", "kind": "js", "title": "5. تحويل النص إلى رقم — Number()", "unit": 3, "source": "units/unit3.html#number"}, "u3-operators-0": {"code": "var a = 10;\nvar b = 5;\n\nvar sum = a + b;   // 15\nvar sub = a - b;   // 5\nvar mul = a * b;   // 50\nvar div = a / b;   // 2\nvar mod = 10 % 3;  // 1", "kind": "js", "title": "6. العمليات الحسابية", "unit": 3, "source": "units/unit3.html#operators"}, "u3-precedence-0": {"code": "var result = 5 + 3 * 2;\n\nalert(result);", "kind": "js", "title": "7. ترتيب تنفيذ العمليات الحسابية", "unit": 3, "source": "units/unit3.html#precedence"}, "u3-if-0": {"code": "var mark = Number(prompt(\"Enter student mark\"));\n\nif(mark >= 50){\n  alert(\"Pass\");\n}", "kind": "js", "title": "8. الجملة الشرطية if", "unit": 3, "source": "units/unit3.html#if"}, "u3-ifelse-0": {"code": "var mark = Number(prompt(\"Enter student mark\"));\n\nif(mark >= 50){\n  alert(\"Pass\");\n}\nelse{\n  alert(\"Fail\");\n}", "kind": "js", "title": "9. الجملة الشرطية if...else", "unit": 3, "source": "units/unit3.html#ifelse"}, "u3-elseif-0": {"code": "var mark = Number(prompt(\"Enter student mark\"));\n\nif(mark >= 90){\n  alert(\"Excellent\");\n}\nelse if(mark >= 80){\n  alert(\"Very Good\");\n}\nelse if(mark >= 70){\n  alert(\"Good\");\n}\nelse if(mark >= 50){\n  alert(\"Pass\");\n}\nelse{\n  alert(\"Fail\");\n}", "kind": "js", "title": "10. الجملة الشرطية else if", "unit": 3, "source": "units/unit3.html#elseif"}, "u3-comparison-0": {"code": "var num1 = Number(prompt(\"Enter first number\"));\nvar num2 = Number(prompt(\"Enter second number\"));\n\nif(num1 > num2){\n  alert(\"First number is larger\");\n}\nelse{\n  alert(\"Second number is larger\");\n}", "kind": "js", "title": "11. معاملات المقارنة", "unit": 3, "source": "units/unit3.html#comparison"}, "u3-switch-0": {"code": "var day = Number(prompt(\"Enter day number (1-3)\"));\n\nswitch(day){\n\n  case 1:\n    alert(\"Sunday\");\n    break;\n\n  case 2:\n    alert(\"Monday\");\n    break;\n\n  case 3:\n    alert(\"Tuesday\");\n    break;\n\n  default:\n    alert(\"Invalid day\");\n}", "kind": "js", "title": "12. الجملة switch", "unit": 3, "source": "units/unit3.html#switch"}, "u3-while-0": {"code": "var i = 1;\n\nwhile(i <= 5){\n  alert(i);\n  i++;\n}", "kind": "js", "title": "14. حلقة while", "unit": 3, "source": "units/unit3.html#while"}, "u3-dowhile-0": {"code": "var number;\n\ndo{\n  number = Number(prompt(\"Enter number greater than 10\"));\n}\nwhile(number <= 10);\n\nalert(\"Correct number\");", "kind": "js", "title": "15. حلقة do...while", "unit": 3, "source": "units/unit3.html#dowhile"}, "u3-for-0": {"code": "var sum = 0;\n\nfor(var i = 1; i <= 5; i++){\n  sum = sum + i;\n}\n\nalert(sum);", "kind": "js", "title": "16. حلقة for", "unit": 3, "source": "units/unit3.html#for"}, "u3-arrays-0": {"code": "var cars = [\"BMW\", \"Toyota\", \"Volvo\"];\n\nalert(cars[0]);", "kind": "js", "title": "17. المصفوفات Arrays", "unit": 3, "source": "units/unit3.html#arrays"}, "u3-arrays-loops-0": {"code": "var cars = [\"BMW\", \"Toyota\", \"Volvo\"];\n\nfor(var i = 0; i < cars.length; i++){\n  alert(cars[i]);\n}", "kind": "js", "title": "18. استخدام المصفوفات مع الحلقات", "unit": 3, "source": "units/unit3.html#arrays-loops"}, "u3-functions-0": {"code": "function multiply(a, b){\n  return a * b;\n}\n\nvar result = multiply(4, 3);\n\nalert(result);", "kind": "js", "title": "19. الدوال Functions", "unit": 3, "source": "units/unit3.html#functions"}, "u3-full-example-0": {"code": "var n = Number(prompt(\"Enter number of values\"));\nvar sum = 0;\n\nfor(var i = 1; i <= n; i++){\n  var num = Number(prompt(\"Enter number\"));\n  sum = sum + num;\n}\n\nalert(\"Total = \" + sum);", "kind": "js", "title": "20. مثال تطبيقي شامل", "unit": 3, "source": "units/unit3.html#full-example"}, "u3-exercises-0": {"code": "var name = prompt(\"Enter your name\");\nalert(\"Welcome \" + name);", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-1": {"code": "var num1 = Number(prompt(\"Enter first number\"));\nvar num2 = Number(prompt(\"Enter second number\"));\nvar sum = num1 + num2;\nalert(\"Sum = \" + sum);", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-2": {"code": "var length = Number(prompt(\"Enter length\"));\nvar width = Number(prompt(\"Enter width\"));\nvar area = length * width;\nalert(\"Area = \" + area);", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-3": {"code": "var num = Number(prompt(\"Enter a number\"));\n\nif(num % 2 == 0){\n  alert(\"Even number\");\n}\nelse{\n  alert(\"Odd number\");\n}", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-4": {"code": "var mark = Number(prompt(\"Enter student mark\"));\n\nif(mark >= 50){\n  alert(\"Pass\");\n}\nelse{\n  alert(\"Fail\");\n}", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-5": {"code": "var sum = 0;\n\nfor(var i = 1; i <= 10; i++){\n  sum = sum + i;\n}\n\nalert(\"Sum = \" + sum);", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-6": {"code": "var i = 1;\n\nwhile(i <= 5){\n  document.write(i + \"<br>\");\n  i++;\n}", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-7": {"code": "var m1 = Number(prompt(\"Enter mark 1\"));\nvar m2 = Number(prompt(\"Enter mark 2\"));\nvar m3 = Number(prompt(\"Enter mark 3\"));\n\nvar avg = (m1 + m2 + m3) / 3;\n\nalert(\"Average = \" + avg);", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-8": {"code": "var cities = [\"Hebron\", \"Jerusalem\", \"Ramallah\"];\n\nfor(var i = 0; i < cities.length; i++){\n  document.write(cities[i] + \"<br>\");\n}", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u3-exercises-9": {"code": "function square(num){\n  return num * num;\n}\n\nvar result = square(5);\nalert(result);", "kind": "js", "title": "22. التمارين مع الحلول", "unit": 3, "source": "units/unit3.html#exercises"}, "u4-gui-2": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>مثال GUI</title>\n</head>\n<body>\n  <h3>مثال على عناصر GUI</h3>\n\n  <label>الاسم:</label>\n  <input id=\"name\" type=\"text\" placeholder=\"اكتب اسمك\">\n\n  <label>اللون المفضل:</label>\n  <select id=\"color\">\n    <option value=\"الأزرق\">الأزرق</option>\n    <option value=\"الأخضر\">الأخضر</option>\n    <option value=\"الأحمر\">الأحمر</option>\n  </select>\n\n  <button onclick=\"showInfo()\">اعرض</button>\n  <p id=\"result\"></p>\n\n  <script>\n    function showInfo(){\n      let name  = document.getElementById(\"name\").value;\n      let color = document.getElementById(\"color\").value;\n      document.getElementById(\"result\").innerHTML =\n        \"مرحبًا \" + name + \"، لونك المفضل هو \" + color;\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧩 أولاً: واجهة المستخدم الرسومية GUI", "unit": 4, "source": "units/unit4.html#gui"}, "u4-validation-2": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Validation Example</title>\n</head>\n<body>\n  <h3>التحقق من بيانات المستخدم</h3>\n  <input id=\"name\" type=\"text\" placeholder=\"الاسم\">\n  <input id=\"age\"  type=\"text\" placeholder=\"العمر\">\n  <button onclick=\"checkData()\">تحقق</button>\n  <p id=\"result\"></p>\n\n  <script>\n    function checkData() {\n      let name = document.getElementById(\"name\").value.trim();\n      let age  = document.getElementById(\"age\").value.trim();\n\n      if (name === \"\" || age === \"\")\n        document.getElementById(\"result\").innerHTML = \"⚠️ الرجاء تعبئة جميع الحقول\";\n      else if (isNaN(age))\n        document.getElementById(\"result\").innerHTML = \"⚠️ العمر يجب أن يكون رقمًا\";\n      else if (age < 0 || age > 100)\n        document.getElementById(\"result\").innerHTML = \"⚠️ العمر يجب أن يكون بين 0 و100\";\n      else\n        document.getElementById(\"result\").innerHTML = \"✅ البيانات صحيحة، شكرًا \" + name;\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "✅ ثانياً: التحقق من صحة البيانات Form Validation", "unit": 4, "source": "units/unit4.html#validation"}, "u4-dhtml-2": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>DHTML Example</title>\n</head>\n<body>\n  <div id=\"box\" style=\"padding:15px;border:2px solid #ccc;border-radius:8px;\">\n    محتوى أصلي\n  </div>\n  <button onclick=\"changeContent()\">غيّر المحتوى</button>\n  <button onclick=\"reset()\">إعادة</button>\n\n  <script>\n    function changeContent() {\n      let box = document.getElementById(\"box\");\n      box.innerHTML = \"✅ تم تغيير هذا الجزء بدون تحميل الصفحة!\";\n      box.style.background = \"#dbeafe\";\n    }\n    function reset() {\n      let box = document.getElementById(\"box\");\n      box.innerHTML = \"محتوى أصلي\";\n      box.style.background = \"\";\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "⚡ ثالثاً: صفحات الويب الديناميكية DHTML", "unit": 4, "source": "units/unit4.html#dhtml"}, "u4-dom-3": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>DOM Example</title>\n</head>\n<body>\n  <h2 id=\"title\">عنوان قديم</h2>\n  <p  id=\"info\">لون العنوان: أسود</p>\n\n  <button onclick=\"changeTitle()\">غيّر العنوان</button>\n  <button onclick=\"changeColor()\">غيّر اللون</button>\n  <button onclick=\"resetAll()\">إعادة</button>\n\n  <script>\n    function changeTitle() {\n      document.getElementById(\"title\").innerHTML = \"✅ عنوان جديد باستخدام DOM\";\n    }\n    function changeColor() {\n      document.getElementById(\"title\").style.color = \"teal\";\n      document.getElementById(\"info\").innerHTML = \"لون العنوان: أخضر مائي (teal)\";\n    }\n    function resetAll() {\n      document.getElementById(\"title\").innerHTML = \"عنوان قديم\";\n      document.getElementById(\"title\").style.color = \"\";\n      document.getElementById(\"info\").innerHTML = \"لون العنوان: أسود\";\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧠 رابعاً: نموذج كائن الوثيقة DOM", "unit": 4, "source": "units/unit4.html#dom"}, "u4-events-2": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Events Example</title>\n</head>\n<body>\n  <h3>تجربة الأحداث</h3>\n\n  <button onclick=\"showMsg('تم النقر على الزر')\">\n    انقر هنا (onclick)\n  </button>\n\n  <div onmouseover=\"showMsg('مررت بالفأرة فوق المربع')\"\n       onmouseout=\"showMsg('أبعدت الفأرة عن المربع')\"\n       style=\"margin-top:14px;padding:14px;border:2px solid #ccc;border-radius:8px;\">\n    مرّر الفأرة هنا (onmouseover / onmouseout)\n  </div>\n\n  <p id=\"result\"></p>\n\n  <script>\n    function showMsg(msg) {\n      document.getElementById(\"result\").innerHTML = msg;\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🖱️ خامساً: التعامل مع الأحداث Events", "unit": 4, "source": "units/unit4.html#events"}, "u4-animation-3": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Animation Example</title>\n</head>\n<body>\n  <!-- مساحة الحركة -->\n  <div style=\"position:relative;height:150px;border:2px solid #ccc;border-radius:8px;overflow:hidden;\">\n    <div id=\"ball\"\n         style=\"position:absolute;right:10px;top:45px;\n                width:50px;height:50px;border-radius:50%;background:orange;\">\n    </div>\n  </div>\n\n  <button onclick=\"startMove()\">▶ ابدأ</button>\n  <button onclick=\"stopMove()\">⏹ أوقف</button>\n\n  <script>\n    let timer = null;\n    let pos   = 10;\n    let dir   = 1;\n\n    function move() {\n      pos += 5 * dir;\n      if (pos > 300) dir = -1;\n      if (pos < 10)  dir =  1;\n      document.getElementById(\"ball\").style.right = pos + \"px\";\n      timer = setTimeout(move, 30);\n    }\n\n    function startMove() {\n      if (!timer) move();\n    }\n\n    function stopMove() {\n      clearTimeout(timer);\n      timer = null;\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🎈 سادساً: الكائنات المتحركة Animation", "unit": 4, "source": "units/unit4.html#animation"}, "u4-practical-exercises-2": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<body>\n  <input id=\"name\" type=\"text\" placeholder=\"اكتب اسمك\">\n  <button onclick=\"show()\">عرض</button>\n  <p id=\"result\"></p>\n\n  <script>\n    function show() {\n      let name = document.getElementById(\"name\").value;\n      document.getElementById(\"result\").innerHTML = \"مرحبًا: \" + name;\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧪 تدريبات عملية مع الحلول", "unit": 4, "source": "units/unit4.html#practical-exercises"}, "u4-practical-exercises-5": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<body>\n  <input id=\"age\" placeholder=\"أدخل العمر\">\n  <button onclick=\"check()\">تحقق</button>\n  <p id=\"result\"></p>\n\n  <script>\n    function check() {\n      let v = document.getElementById(\"age\").value.trim();\n      if (v === \"\") {\n        document.getElementById(\"result\").innerHTML = \"⚠️ الحقل فارغ\";\n      } else if (isNaN(v)) {\n        document.getElementById(\"result\").innerHTML = \"❌ أدخل رقمًا فقط\";\n      } else {\n        document.getElementById(\"result\").innerHTML = \"✅ العمر صحيح: \" + v;\n      }\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧪 تدريبات عملية مع الحلول", "unit": 4, "source": "units/unit4.html#practical-exercises"}, "u4-practical-exercises-8": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<body>\n  <p id=\"t\">هذا هو النص القديم</p>\n  <button onclick=\"changeText()\">غيّر النص</button>\n  <button onclick=\"resetText()\">إعادة</button>\n\n  <script>\n    function changeText() {\n      document.getElementById(\"t\").innerHTML = \"✅ تم تغيير النص بنجاح!\";\n    }\n    function resetText() {\n      document.getElementById(\"t\").innerHTML = \"هذا هو النص القديم\";\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧪 تدريبات عملية مع الحلول", "unit": 4, "source": "units/unit4.html#practical-exercises"}, "u4-practical-exercises-11": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<body>\n  <div onmouseover=\"enter()\"\n       onmouseout=\"leave()\"\n       style=\"padding:20px;border:2px solid #ccc;border-radius:8px;\n              background:#f9f9f9;cursor:pointer;\">\n    مرّر الفأرة هنا\n  </div>\n  <p id=\"r\"></p>\n\n  <script>\n    function enter() {\n      document.getElementById(\"r\").innerHTML = \"🖱️ الفأرة داخل المربع\";\n    }\n    function leave() {\n      document.getElementById(\"r\").innerHTML = \"👋 الفأرة خارج المربع\";\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧪 تدريبات عملية مع الحلول", "unit": 4, "source": "units/unit4.html#practical-exercises"}, "u4-practical-exercises-14": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<body>\n  <img id=\"img\"\n       src=\"https://picsum.photos/100\"\n       width=\"100\"\n       style=\"border-radius:8px;\">\n  <br><br>\n  <button onclick=\"grow()\">كبّر الصورة</button>\n  <button onclick=\"shrink()\">صغّر الصورة</button>\n  <p id=\"sizeInfo\">الحجم الحالي: 100px</p>\n\n  <script>\n    function grow() {\n      let img = document.getElementById(\"img\");\n      if (img.width < 200) {\n        img.width += 20;\n        document.getElementById(\"sizeInfo\").innerHTML = \"الحجم الحالي: \" + img.width + \"px\";\n      } else {\n        document.getElementById(\"sizeInfo\").innerHTML = \"⚠️ وصلنا للحد الأقصى (200px)\";\n      }\n    }\n    function shrink() {\n      let img = document.getElementById(\"img\");\n      if (img.width > 60) {\n        img.width -= 20;\n        document.getElementById(\"sizeInfo\").innerHTML = \"الحجم الحالي: \" + img.width + \"px\";\n      }\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧪 تدريبات عملية مع الحلول", "unit": 4, "source": "units/unit4.html#practical-exercises"}, "u4-practical-exercises-15": {"code": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: sans-serif; padding: 20px; }\n    #box {\n      width: 80px; height: 80px;\n      background: teal; border-radius: 8px;\n      transition: all 0.4s;\n      margin-top: 16px;\n    }\n  </style>\n</head>\n<body>\n  <h3>مشروعي المصغر</h3>\n  <input id=\"name\" type=\"text\" placeholder=\"اكتب اسمك\">\n  <button onclick=\"runApp()\">تنفيذ</button>\n  <p id=\"msg\"></p>\n  <div id=\"box\"></div>\n\n  <script>\n    function runApp() {\n      let name = document.getElementById(\"name\").value.trim();\n      if (name === \"\") {\n        document.getElementById(\"msg\").innerHTML = \"⚠️ الرجاء إدخال الاسم أولًا\";\n        document.getElementById(\"box\").style.width = \"80px\";\n        document.getElementById(\"box\").style.height = \"80px\";\n        document.getElementById(\"box\").style.background = \"teal\";\n      } else {\n        document.getElementById(\"msg\").innerHTML = \"✅ مرحبًا \" + name + \"!\";\n        document.getElementById(\"box\").style.width = \"160px\";\n        document.getElementById(\"box\").style.height = \"160px\";\n        document.getElementById(\"box\").style.background = \"coral\";\n      }\n    }\n  </script>\n</body>\n</html>", "kind": "html", "title": "🧪 تدريبات عملية مع الحلول", "unit": 4, "source": "units/unit4.html#practical-exercises"}, "unit2practicalsolution-1-0": {"code": "<!doctype html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>نشاط أخطاء 1</title>\r\n</head>\r\n<body>\r\n  <h2>مرحبا بكم\r\n  <p>هذه فقرة تجريبية</p>\r\n  <a>زيارة موقع</a>\r\n</body>\r\n</html>", "kind": "html", "title": "السؤال 1: معرفة الخطأ (Debugging)", "unit": 2, "source": "units/unit2practicalsolution.html#practice-2"}, "unit2practicalsolution-1-1": {"code": "<!doctype html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>نشاط أخطاء 1</title>\r\n</head>\r\n<body>\r\n  <h2>مرحبا بكم</h2>\r\n  <p>هذه فقرة تجريبية</p>\r\n  <a href=\"https://example.com\">زيارة موقع</a>\r\n</body>\r\n</html>", "kind": "html", "title": "السؤال 1: معرفة الخطأ (Debugging)", "unit": 2, "source": "units/unit2practicalsolution.html#practice-2"}, "unit2practicalsolution-1-2": {"code": "<!doctype html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>نشاط أخطاء 2</title>\r\n</head>\r\n<body>\r\n  <h2>صورة ورابط</h2>\r\n\r\n  <img scr=\"images/photo.jpg\" alt=صورة width=200px>\r\n\r\n  <a href=\"www.google.com\" target=\"_blanck\">Google</a>\r\n</body>\r\n</html>", "kind": "html", "title": "السؤال 1: معرفة الخطأ (Debugging)", "unit": 2, "source": "units/unit2practicalsolution.html#practice-2"}, "unit2practicalsolution-1-3": {"code": "<!doctype html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>نشاط أخطاء 2</title>\r\n</head>\r\n<body>\r\n  <h2>صورة ورابط</h2>\r\n\r\n  <img src=\"images/photo.jpg\" alt=\"صورة\" width=\"200\">\r\n\r\n  <a href=\"https://www.google.com\" target=\"_blank\">Google</a>\r\n</body>\r\n</html>", "kind": "html", "title"